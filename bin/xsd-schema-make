#!/usr/bin/env php
<?php declare(strict_types=1);

use Adawolfa\ISDOC\Generator\Generator;
use Dom\XMLDocument;
use GoetasWebservices\XML\XSDReader\SchemaReader;
use Symfony\Component\Console;

require(__DIR__ . '/../vendor/autoload.php');
require(__DIR__ . '/../bin/generator/Generator.php');

/** @noinspection PhpUnhandledExceptionInspection */
(new Console\SingleCommandApplication)
	->addArgument('xsd', Console\Input\InputArgument::OPTIONAL, '', __DIR__ . '/../xsd/isdoc-invoice-6.0.2.xsd')
	->addArgument('folder', Console\Input\InputArgument::OPTIONAL, '', __DIR__ . '/../src/Schema')
	->addArgument('namespace', Console\Input\InputArgument::OPTIONAL, '', 'Adawolfa\\ISDOC\\Schema')
	->setCode(function (Console\Input\InputInterface $input, Console\Output\OutputInterface $output): int {

		$xsd    = $input->getArgument('xsd');
		$schema = (new SchemaReader)->readFile($xsd);

		// The goetas reader drops the <xs:schema version="…"> attribute, so read it straight off the root element.
		$version = XMLDocument::createFromFile($xsd)->documentElement?->getAttribute('version') ?? '';

		$generator = new Generator(
			$input->getArgument('folder'),
			$input->getArgument('namespace'),
		);

		$generator->make($schema, $version);
		$generator->write();

		$folder = $input->getArgument('folder');
		exec(escapeshellarg(__DIR__ . '/../vendor/bin/phpcbf') . ' ' . escapeshellarg($folder) . ' 2>&1');
		$output->writeln("Generated and formatted into $folder.");

		return 0;

	})
	->run();
