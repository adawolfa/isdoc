{
	"name": "adawolfa/isdoc",
	"type": "library",
	"description": "ISDOC parser and generator.",
	"license": ["MIT"],
	"authors": [
		{
			"name": "Adam Klvač",
			"homepage": "https://klva.cz",
			"email": "adam@klva.cz"
		}
	],
	"require": {
		"php": ">=8.3",
		"ext-bcmath": "*",
		"ext-simplexml": "*",
		"ext-zip": "*",
		"nette/utils": "^3.2|^4.0",
		"symfony/serializer": "^6.0|^7.0|^8.0"
	},
	"require-dev": {
		"goetas-webservices/xsd-reader": "^0.3|^0.4",
		"smalot/pdfparser": "^2.12",
		"symfony/console": "^6.0|^7.0|^8.0",
		"nette/php-generator": "^3.6|^4.0",
		"phpunit/phpunit": "^10.0|^11.0|^12.0",
		"phpstan/phpstan": "^1.12|^2.0"
	},
	"autoload": {
		"psr-4": {
			"Adawolfa\\ISDOC\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\Adawolfa\\ISDOC\\": "tests/"
		}
	},
	"suggest": {
		"smalot/pdfparser": "Support for reading PDF with embedded ISDOC"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.5.x-dev"
		}
	}
}