{
	"name": "adawolfa/isdoc",
	"type": "library",
	"description": "ISDOC parser and generator.",
	"license": ["MIT"],
	"authors": [
		{
			"name": "Adam Klvač",
			"homepage": "https://klva.cz",
			"email": "adam@klva.cz"
		}
	],
	"require": {
		"php": ">=8.4",
		"ext-bcmath": "*",
		"ext-dom": "*",
		"ext-zip": "*",
		"ext-libxml": "*"
	},
	"require-dev": {
		"goetas-webservices/xsd-reader": "^0.3|^0.4",
		"smalot/pdfparser": "^2.12",
		"symfony/console": "^6.0|^7.0|^8.0",
		"phpunit/phpunit": "^10.0|^11.0|^12.0",
		"brianium/paratest": "^7.20",
		"phpstan/phpstan": "^1.12|^2.0",
		"squizlabs/php_codesniffer": "^4.0",
		"slevomat/coding-standard": "^8.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpstan/extension-installer": "^1.4"
	},
	"autoload": {
		"psr-4": {
			"Adawolfa\\ISDOC\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\Adawolfa\\ISDOC\\": "tests/"
		}
	},
	"suggest": {
		"smalot/pdfparser": "Support for reading PDF with embedded ISDOC"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "2.0.x-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
